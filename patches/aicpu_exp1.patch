diff --git a/ms_kernels/src/secure_dma/secure_dma_urma_probe.cc b/ms_kernels/src/secure_dma/secure_dma_urma_probe.cc
new file mode 100644
index 0000000..04fc158
--- /dev/null
+++ b/ms_kernels/src/secure_dma/secure_dma_urma_probe.cc
@@ -0,0 +1,139 @@
+// Copyright (c) 2026 Huawei Technologies Co., Ltd.
+// Licensed under CANN Open Software License Agreement Version 2.0; see LICENSE.
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <dlfcn.h>
+
+#include "secure_dma/secure_dma_urma_probe.h"
+#include "secure_dma/secure_dma_urma_probe_protocol.h"
+#include "secure_dma/secure_dma_protocol.h"
+#include "secure_dma/secure_dma_barrier.h"
+
+// Avoid making libdl or liburma a new mandatory dependency of the platform kernel.
+// An older loader without these symbols produces a diagnostic report instead.
+#pragma weak dlopen
+#pragma weak dlsym
+#pragma weak dlerror
+#pragma weak dladdr
+#pragma weak dlclose
+
+namespace secure_dma {
+namespace {
+template <std::size_t N>
+void CopyText(char (&dest)[N], const char *text)
+{
+    std::size_t i = 0U;
+    if (text != nullptr) {
+        for (; i + 1U < N && text[i] != '\0'; ++i) { dest[i] = text[i]; }
+    }
+    dest[i] = '\0';
+}
+
+void LoaderError(UrmaProbeBlock &report, const char *fallback)
+{
+    const char *error = dlerror != nullptr ? dlerror() : nullptr;
+    CopyText(report.error, error != nullptr ? error : fallback);
+}
+
+void InspectSymbols(void *handle, UrmaProbeBlock &report)
+{
+    report.presentMask = 0U;
+    report.library[0] = '\0';
+    for (std::size_t i = 0U; i < kUrmaProbeSymbolCount; ++i) {
+        if (dlerror != nullptr) { (void)dlerror(); }
+        void *symbol = dlsym(handle, kUrmaProbeSymbols[i]);
+        const char *error = dlerror != nullptr ? dlerror() : nullptr;
+        if (symbol == nullptr || error != nullptr) { continue; }
+        report.presentMask |= UINT64_C(1) << i;
+        // Record one symbol owner; this is not a claim that all symbols have one owner.
+        if (report.library[0] == '\0' && dladdr != nullptr) {
+            Dl_info info{};
+            if (dladdr(symbol, &info) != 0 && info.dli_fname != nullptr) {
+                CopyText(report.library, info.dli_fname);
+            }
+        }
+    }
+}
+
+void Discover(const std::uint32_t flags, UrmaProbeBlock &report)
+{
+    if (dlsym == nullptr) {
+        report.status = static_cast<std::uint32_t>(UrmaProbeStatus::kLoaderUnavailable);
+        CopyText(report.error, "dlsym unavailable in this AICPU process");
+        return;
+    }
+    InspectSymbols(RTLD_DEFAULT, report);
+    if (report.presentMask != 0U) {
+        report.source = static_cast<std::uint32_t>(UrmaProbeSource::kProcess);
+    }
+    if (report.presentMask == kUrmaProbeAllSymbols) { return; }
+    report.status = static_cast<std::uint32_t>(report.presentMask == 0U ?
+        UrmaProbeStatus::kLibraryUnavailable : UrmaProbeStatus::kMissingSymbols);
+    if ((flags & kUrmaProbeAllowLoad) == 0U) {
+        CopyText(report.error, "process-scope lookup incomplete; explicit library loading was not requested");
+        return;
+    }
+    if (dlopen == nullptr || dlclose == nullptr) {
+        report.status = static_cast<std::uint32_t>(UrmaProbeStatus::kLoaderUnavailable);
+        CopyText(report.error, "dlopen/dlclose unavailable in this AICPU process");
+        return;
+    }
+    const char *const candidates[] = {"liburma.so.0", "liburma.so", "liburma.so.0.0.3"};
+    for (const char *name : candidates) {
+        if (dlerror != nullptr) { (void)dlerror(); }
+        void *handle = dlopen(name, RTLD_NOW | RTLD_LOCAL);
+        if (handle == nullptr) {
+            LoaderError(report, "cannot open URMA library");
+            continue;
+        }
+        report.source = static_cast<std::uint32_t>(UrmaProbeSource::kOpenedLibrary);
+        report.error[0] = '\0';
+        InspectSymbols(handle, report);
+        if (report.library[0] == '\0') { CopyText(report.library, name); }
+        report.status = static_cast<std::uint32_t>(report.presentMask == kUrmaProbeAllSymbols ?
+            UrmaProbeStatus::kSymbolsAvailable : UrmaProbeStatus::kMissingSymbols);
+        // Release only our own loader reference. Never uninitialize framework-owned URMA state.
+        if (dlclose(handle) != 0) {
+            report.status = static_cast<std::uint32_t>(UrmaProbeStatus::kCloseFailed);
+            LoaderError(report, "dlclose failed");
+        }
+        return;
+    }
+}
+} // namespace
+
+std::int32_t RunUrmaProbe(const std::uint64_t anchorAddr)
+{
+    if (anchorAddr == 0U || anchorAddr % alignof(UrmaProbeBlock) != 0U ||
+        anchorAddr > static_cast<std::uint64_t>(UINTPTR_MAX) - (sizeof(UrmaProbeBlock) - 1U)) {
+        return kStatusBadArgs;
+    }
+    auto *block = reinterpret_cast<UrmaProbeBlock *>(static_cast<std::uintptr_t>(anchorAddr));
+    if (block->magic != kUrmaProbeMagic || block->version != kUrmaProbeVersion ||
+        block->bytes != sizeof(UrmaProbeBlock) || (block->flags & ~kUrmaProbeAllowLoad) != 0U ||
+        block->cookie == 0U) {
+        return kStatusBadArgs;
+    }
+    for (std::uint64_t value : block->reserved) {
+        if (value != 0U) { return kStatusBadArgs; }
+    }
+    const std::uint32_t flags = block->flags;
+    UrmaProbeBlock report{};
+    report.echoedCookie = block->cookie;
+    report.symbolCount = static_cast<std::uint32_t>(kUrmaProbeSymbolCount);
+#if defined(__aarch64__)
+    report.architecture = 1U;
+#elif defined(__x86_64__)
+    report.architecture = 2U;
+#endif
+    Discover(flags, report);
+    const auto *src = reinterpret_cast<const std::uint8_t *>(&report);
+    auto *dst = reinterpret_cast<std::uint8_t *>(block);
+    for (std::size_t i = offsetof(UrmaProbeBlock, status); i < sizeof(UrmaProbeBlock); ++i) {
+        dst[i] = src[i];
+    }
+    PublishWord(&block->done, 1U); // Last request-memory access; host still waits for native completion.
+    return kStatusOk; // The report carries a negative capability result without failing the native task.
+}
+} // namespace secure_dma
