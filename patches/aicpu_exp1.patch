diff --git a/ms_kernels/src/secure_dma/secure_dma_urma_probe_protocol.h b/ms_kernels/src/secure_dma/secure_dma_urma_probe_protocol.h
new file mode 100644
index 0000000..eb33431
--- /dev/null
+++ b/ms_kernels/src/secure_dma/secure_dma_urma_probe_protocol.h
@@ -0,0 +1,58 @@
+// Copyright (c) 2026 Huawei Technologies Co., Ltd.
+// Licensed under CANN Open Software License Agreement Version 2.0; see LICENSE.
+#ifndef SECURE_DMA_URMA_PROBE_PROTOCOL_H
+#define SECURE_DMA_URMA_PROBE_PROTOCOL_H
+
+#include <cstddef>
+#include <cstdint>
+
+namespace secure_dma {
+constexpr std::uint32_t kUrmaProbeMagic = 0x31504D55U; // UMP1, a diagnostic, never a copy descriptor.
+constexpr std::uint32_t kUrmaProbeVersion = 1U;
+constexpr std::uint32_t kUrmaProbeAllowLoad = 1U;
+enum class UrmaProbeStatus : std::uint32_t {
+    kSymbolsAvailable = 0U,
+    kLoaderUnavailable = 1U,
+    kLibraryUnavailable = 2U,
+    kMissingSymbols = 3U,
+    kCloseFailed = 4U,
+};
+enum class UrmaProbeSource : std::uint32_t { kNone = 0U, kProcess = 1U, kOpenedLibrary = 2U };
+
+constexpr const char *kUrmaProbeSymbols[] = {
+    "urma_init", "urma_uninit", "urma_get_device_list", "urma_free_device_list",
+    "urma_get_eid_list", "urma_free_eid_list", "urma_create_context", "urma_delete_context",
+    "urma_create_jfce", "urma_delete_jfce", "urma_create_jfc", "urma_delete_jfc",
+    "urma_create_jfr", "urma_delete_jfr", "urma_create_jfs", "urma_delete_jfs",
+    "urma_register_seg", "urma_unregister_seg", "urma_import_jfr", "urma_unimport_jfr",
+    "urma_post_jfr_wr", "urma_post_jfs_wr", "urma_poll_jfc", "urma_wait_jfc",
+    "urma_ack_jfc", "urma_rearm_jfc", "urma_query_device",
+};
+constexpr std::size_t kUrmaProbeSymbolCount = sizeof(kUrmaProbeSymbols) / sizeof(kUrmaProbeSymbols[0]);
+constexpr std::uint64_t kUrmaProbeAllSymbols = (UINT64_C(1) << kUrmaProbeSymbolCount) - 1U;
+static_assert(kUrmaProbeSymbolCount < 64U, "symbol mask fits on the wire");
+
+struct alignas(64) UrmaProbeBlock {
+    std::uint32_t magic;
+    std::uint32_t version;
+    std::uint32_t bytes;
+    std::uint32_t flags;
+    std::uint64_t cookie;
+    std::uint64_t reserved[5];
+    // Output. Read only after native stream synchronization, never through a polling DMA loop.
+    std::uint32_t status;
+    std::uint32_t source;
+    std::uint32_t symbolCount;
+    std::uint32_t architecture; // 1 = AArch64, 2 = x86_64 (local tests), 0 = other.
+    std::uint64_t presentMask;
+    std::uint64_t echoedCookie;
+    char library[256];
+    char error[256];
+    std::uint32_t done;
+    std::uint32_t reservedOutput[7];
+};
+static_assert(sizeof(UrmaProbeBlock) == 640U, "fixed diagnostic wire size");
+static_assert(offsetof(UrmaProbeBlock, status) == 64U, "separate request and report");
+static_assert(offsetof(UrmaProbeBlock, done) == 608U, "fixed completion offset");
+} // namespace secure_dma
+#endif
diff --git a/test/test_secure_dma_urma_probe.cc b/test/test_secure_dma_urma_probe.cc
new file mode 100644
index 0000000..8d86a65
--- /dev/null
+++ b/test/test_secure_dma_urma_probe.cc
@@ -0,0 +1,190 @@
+// Copyright (c) 2026 Huawei Technologies Co., Ltd.
+// Licensed under CANN Open Software License Agreement Version 2.0; see LICENSE.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <vector>
+
+#include "kernel_base.h"
+#include "secure_dma.h"
+#include "secure_dma/secure_dma_device.h"
+#include "secure_dma/secure_dma_protocol.h"
+#include "secure_dma/secure_dma_urma_probe.h"
+#include "secure_dma/secure_dma_urma_probe_protocol.h"
+
+namespace {
+using namespace secure_dma;
+int failures = 0;
+unsigned checks = 0;
+uint64_t processMask = 0U;
+uint64_t libraryMask = 0U;
+unsigned opens = 0U, closes = 0U, lookups = 0U;
+unsigned openAfter = 1U;
+bool closeFails = false;
+bool reportOwner = true;
+int libraryHandle;
+const char *loaderError = nullptr;
+
+void Check(bool ok, const char *message)
+{
+    ++checks;
+    if (!ok) { ++failures; std::printf("FAIL %s\n", message); }
+}
+
+// Any accidental call through a discovered URMA symbol fails the test immediately.
+void MustNotCallUrma() { std::abort(); }
+
+UrmaProbeBlock Request()
+{
+    opens = closes = lookups = 0U;
+    processMask = libraryMask = 0U;
+    openAfter = 1U;
+    closeFails = false;
+    reportOwner = true;
+    loaderError = nullptr;
+    UrmaProbeBlock block{};
+    block.magic = kUrmaProbeMagic;
+    block.version = kUrmaProbeVersion;
+    block.bytes = sizeof(block);
+    block.cookie = UINT64_C(0x1122334455667788);
+    block.status = UINT32_MAX;
+    return block;
+}
+
+void Expect(UrmaProbeBlock &block, UrmaProbeStatus status, UrmaProbeSource source, uint64_t mask,
+            unsigned wantOpens, unsigned wantCloses)
+{
+    const auto before = block;
+    Check(RunDeviceSide(reinterpret_cast<uint64_t>(&block), 0U) == kStatusOk, "real dispatcher accepts probe");
+    Check(std::memcmp(&before, &block, offsetof(UrmaProbeBlock, status)) == 0, "request prefix preserved");
+    Check(block.status == static_cast<uint32_t>(status), "capability status");
+    Check(block.source == static_cast<uint32_t>(source), "symbol source");
+    Check(block.presentMask == mask && block.symbolCount == kUrmaProbeSymbolCount, "exact symbol mask");
+    Check(block.done == 1U && block.echoedCookie == before.cookie, "completion and cookie");
+    Check(opens == wantOpens && closes == wantCloses, "only owned loader references released");
+    Check(block.library[255] == '\0' && block.error[255] == '\0', "bounded report strings");
+}
+
+void Cases()
+{
+    auto block = Request();
+    Expect(block, UrmaProbeStatus::kLibraryUnavailable, UrmaProbeSource::kNone, 0U, 0U, 0U);
+    block = Request(); processMask = kUrmaProbeAllSymbols;
+    Expect(block, UrmaProbeStatus::kSymbolsAvailable, UrmaProbeSource::kProcess, processMask, 0U, 0U);
+    block = Request(); processMask = kUrmaProbeAllSymbols & ~(UINT64_C(1) << 22U);
+    Expect(block, UrmaProbeStatus::kMissingSymbols, UrmaProbeSource::kProcess, processMask, 0U, 0U);
+    block = Request(); block.flags = kUrmaProbeAllowLoad; libraryMask = kUrmaProbeAllSymbols;
+    Expect(block, UrmaProbeStatus::kSymbolsAvailable, UrmaProbeSource::kOpenedLibrary, libraryMask, 1U, 1U);
+    block = Request(); block.flags = kUrmaProbeAllowLoad; libraryMask = 5U;
+    Expect(block, UrmaProbeStatus::kMissingSymbols, UrmaProbeSource::kOpenedLibrary, 5U, 1U, 1U);
+    block = Request(); block.flags = kUrmaProbeAllowLoad; openAfter = 4U;
+    Expect(block, UrmaProbeStatus::kLibraryUnavailable, UrmaProbeSource::kNone, 0U, 3U, 0U);
+    Check(std::strcmp(block.error, "mock library absent") == 0, "loader error preserved");
+    block = Request(); block.flags = kUrmaProbeAllowLoad; openAfter = 3U;
+    libraryMask = kUrmaProbeAllSymbols; reportOwner = false;
+    Expect(block, UrmaProbeStatus::kSymbolsAvailable, UrmaProbeSource::kOpenedLibrary, libraryMask, 3U, 1U);
+    Check(std::strcmp(block.library, "liburma.so.0.0.3") == 0, "soname fallback without dladdr owner");
+    block = Request(); block.flags = kUrmaProbeAllowLoad; closeFails = true;
+    libraryMask = kUrmaProbeAllSymbols;
+    Expect(block, UrmaProbeStatus::kCloseFailed, UrmaProbeSource::kOpenedLibrary, libraryMask, 1U, 1U);
+    block = Request(); block.flags = kUrmaProbeAllowLoad; processMask = kUrmaProbeAllSymbols;
+    Expect(block, UrmaProbeStatus::kSymbolsAvailable, UrmaProbeSource::kProcess, processMask, 0U, 0U);
+    block = Request(); block.flags = kUrmaProbeAllowLoad; processMask = 2U; openAfter = 4U;
+    Expect(block, UrmaProbeStatus::kMissingSymbols, UrmaProbeSource::kProcess, 2U, 3U, 0U);
+}
+
+void Refusals()
+{
+    for (unsigned scenario = 0; scenario < 10; ++scenario) {
+        auto block = Request();
+        switch (scenario) {
+            case 0: ++block.magic; break;
+            case 1: ++block.version; break;
+            case 2: --block.bytes; break;
+            case 3: block.flags = 2U; break;
+            case 4: block.cookie = 0U; break;
+            default: block.reserved[scenario - 5U] = 1U; break;
+        }
+        const auto before = block;
+        Check(RunUrmaProbe(reinterpret_cast<uint64_t>(&block)) == kStatusBadArgs, "invalid request refused");
+        Check(std::memcmp(&block, &before, sizeof(block)) == 0, "refusal leaves request unchanged");
+        Check(lookups == 0U && opens == 0U, "invalid request cannot trigger loader");
+    }
+    Check(RunUrmaProbe(0) == kStatusBadArgs, "null anchor refused");
+    Check(RunUrmaProbe(65) == kStatusBadArgs, "misaligned anchor refused before access");
+    Check(RunUrmaProbe(UINT64_MAX - 63U) == kStatusBadArgs, "overflow refused before access");
+}
+
+void Adapter()
+{
+    auto block = Request(); processMask = kUrmaProbeAllSymbols;
+    // Use the framework stub's documented encoding, not the real protobuf wire format.
+    const char key[] = "scc_dma_args";
+    std::vector<uint8_t> node;
+    auto put32 = [&](uint32_t n) {
+        const auto *bytes = reinterpret_cast<const uint8_t *>(&n);
+        node.insert(node.end(), bytes, bytes + 4U);
+    };
+    put32(1U); put32(sizeof(key) - 1U);
+    node.insert(node.end(), key, key + sizeof(key) - 1U); put32(16U);
+    const uint64_t addresses[2] = {reinterpret_cast<uint64_t>(&block), 0U};
+    const auto *bytes = reinterpret_cast<const uint8_t *>(addresses);
+    node.insert(node.end(), bytes, bytes + sizeof(addresses));
+    aicpu::AicpuParamHead head{};
+    head.length = static_cast<uint32_t>(sizeof(head) + 4U + node.size());
+    std::vector<uint8_t> args(head.length);
+    std::memcpy(args.data(), &head, sizeof(head));
+    const uint32_t length = static_cast<uint32_t>(node.size());
+    std::memcpy(args.data() + sizeof(head), &length, 4U);
+    std::memcpy(args.data() + sizeof(head) + 4U, node.data(), node.size());
+    Check(SecureDma(args.data()) == AICPU_KERNEL_STATE_SUCCESS, "real exported entry accepts attribute anchor");
+    Check(block.done == 1U && block.presentMask == kUrmaProbeAllSymbols, "exported entry returns complete report without key");
+}
+} // namespace
+
+// Deterministic loader seam: production probe still resolves symbols but never invokes URMA.
+extern "C" void *dlsym(void *handle, const char *name) noexcept
+{
+    ++lookups;
+    const uint64_t mask = handle == RTLD_DEFAULT ? processMask : libraryMask;
+    for (size_t i = 0; i < kUrmaProbeSymbolCount; ++i) {
+        if (std::strcmp(name, kUrmaProbeSymbols[i]) == 0 && (mask & (UINT64_C(1) << i)) != 0U) {
+            return reinterpret_cast<void *>(&MustNotCallUrma);
+        }
+    }
+    return nullptr;
+}
+extern "C" void *dlopen(const char *, int flags) noexcept
+{
+    Check(flags == (RTLD_NOW | RTLD_LOCAL), "load uses immediate, local symbol binding");
+    ++opens;
+    if (opens >= openAfter) { return &libraryHandle; }
+    loaderError = "mock library absent";
+    return nullptr;
+}
+extern "C" int dlclose(void *handle) noexcept
+{
+    Check(handle == &libraryHandle, "close only handle returned by own open");
+    ++closes;
+    if (closeFails) { loaderError = "mock close failure"; return -1; }
+    return 0;
+}
+extern "C" int dladdr(const void *, Dl_info *info) noexcept
+{
+    info->dli_fname = "/mock/device/liburma.so.0";
+    return reportOwner ? 1 : 0;
+}
+extern "C" char *dlerror() noexcept
+{
+    const char *error = loaderError;
+    loaderError = nullptr;
+    return const_cast<char *>(error);
+}
+
+int main()
+{
+    Cases(); Refusals(); Adapter();
+    std::printf("AICPU URMA loader probe: %u checks, %d failures (mock loader, CPU memory)\n", checks, failures);
+    return failures == 0 ? 0 : 1;
+}
